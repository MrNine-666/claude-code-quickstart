{
  "SchemaVersion": 1,
  "Source": "installer/linux/core/Platform.sh",
  "Description": "Linux 发行版矩阵唯一 owner。Bash runtime 在 bootstrap 前不能依赖 Node/jq，Platform.sh/PackageManager.sh 保留等价实现；Test-LinuxInstaller.sh 通过 linux-platform-expectations.mjs 展开的期望表检测漂移。",
  "Libc": {
    "Required": "glibc",
    "Reject": ["musl"]
  },
  "Wsl": {
    "WSL1": "unsupported",
    "WSL2": "best-effort"
  },
  "Architectures": {
    "x64": ["x86_64", "amd64"],
    "arm64": ["aarch64", "arm64"]
  },
  "Families": {
    "debian": { "PackageManager": "apt" },
    "fedora": { "PackageManager": "dnf" },
    "arch": { "PackageManager": "pacman" }
  },
  "PackageManagers": {
    "apt": {
      "Command": "apt-get",
      "Update": ["apt-get", "update"],
      "InstallGit": ["apt-get", "install", "-y", "git"],
      "FailureStatus": "Failed"
    },
    "dnf": {
      "Command": "dnf",
      "InstallGit": ["dnf", "install", "-y", "git"],
      "FailureStatus": "Failed"
    },
    "pacman": {
      "Command": "pacman",
      "InstallGit": ["pacman", "-S", "--needed", "--noconfirm", "git"],
      "FailureStatus": "ManualRequired",
      "ManualHint": "sudo pacman -Syu git"
    }
  },
  "Distributions": [
    {
      "Id": "ubuntu",
      "Name": "Ubuntu",
      "Family": "debian",
      "Image": "ubuntu:24.04",
      "OfficialVersion": "24.04",
