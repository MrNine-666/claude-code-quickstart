      "OfficialVersion": "44",
      "MinVersion": "42"
    },
    {
      "Id": "centos",
      "Name": "CentOS Stream",
      "Family": "fedora",
      "Image": "quay.io/centos/centos:stream10",
      "OfficialVersion": "10",
      "AllowedVersions": ["9", "10"],
      "RequiredNameContains": "Stream"
    },
    {
      "Id": "arch",
      "Name": "Arch Linux",
      "Family": "arch",
      "Image": "archlinux:latest",
      "OfficialVersion": "rolling",
      "Rolling": true
    }
  ],
