{
  "SchemaVersion": 1,
  "Source": "contracts/build.json",
  "DefaultOutputDirectory": "dist",
  "BuildEntrypoints": {
    "Windows": {
      "Script": "installer/build.ps1",
      "AllowedPlatforms": [
        "Windows"
      ],
      "Artifacts": [
        "install.ps1",
        "download-tui.ps1"
      ]
    },
    "Unix": {
      "Script": "installer/build.sh",
      "AllowedPlatforms": [
        "macos",
        "linux"
      ],
      "Artifacts": [
        "install.sh",
        "download-tui.sh",
        "download-tui.zsh"
      ]
    },
    "ReleaseArtifacts": [
      "ccq-windows-x64.exe",
      "ccq-windows-x64.exe.gz",
      "ccq-windows-arm64.exe",
      "ccq-windows-arm64.exe.gz",
      "ccq-macos-x64",
      "ccq-macos-x64.gz",
      "ccq-macos-arm64",
      "ccq-macos-arm64.gz",
      "ccq-linux-x64",
      "ccq-linux-x64.gz",
      "ccq-linux-arm64",
      "ccq-linux-arm64.gz"
    ]
  },
  "UpdateTransports": {
    "GzipAssets": [
      {
        "Raw": "ccq-windows-x64.exe",
        "Gzip": "ccq-windows-x64.exe.gz"
      },
      {
        "Raw": "ccq-windows-arm64.exe",
        "Gzip": "ccq-windows-arm64.exe.gz"
      },
      {
        "Raw": "ccq-macos-x64",
        "Gzip": "ccq-macos-x64.gz"
      },
      {
        "Raw": "ccq-macos-arm64",
        "Gzip": "ccq-macos-arm64.gz"
      },
      {
        "Raw": "ccq-linux-x64",
        "Gzip": "ccq-linux-x64.gz"
      },
      {
        "Raw": "ccq-linux-arm64",
        "Gzip": "ccq-linux-arm64.gz"
      }
    ]
  },
  "Windows": {
    "StepContract": "installer/contracts/steps.json",
    "CanonicalStepPrefix": "windows/",
    "Artifacts": [
      {
        "Role": "Install",
        "OutputFile": "install.ps1",
        "RequiresHeader": "#Requires -Version 5.1",
        "EntryFile": "windows/Install.ps1",
        "HoistParamFrom": "windows/Install.ps1",
        "OutputEncoding": "asciiTrampoline",
        "CoreFiles": [
          "windows/core/Json.ps1",
          "windows/core/Ui.ps1",
          "windows/core/Process.ps1",
          "windows/core/Profile.ps1",
          "windows/core/Update.ps1",
          "windows/core/Admin.ps1",
          "windows/core/Net.ps1",
          "windows/core/Ccq.ps1",
          "windows/core/Registry.ps1",
          "windows/core/Bootstrap.ps1"
        ],
        "IncludeSteps": true
      },
      {
        "Role": "CcqDownload",
        "OutputFile": "download-tui.ps1",
        "RequiresHeader": "#Requires -Version 5.1",
        "EntryFile": "windows/Download-Tui.ps1",
        "HoistParamFrom": "windows/Download-Tui.ps1",
        "OutputEncoding": "asciiTrampoline",
        "CoreFiles": [
          "windows/core/Json.ps1",
          "windows/core/Ui.ps1",
          "windows/core/Process.ps1",
          "windows/core/Net.ps1",
          "windows/core/Ccq.ps1",
          "windows/core/Registry.ps1"
        ],
        "IncludeSteps": false
      }
    ]
  },
  "MacOS": {
    "StepContract": "installer/contracts/steps.json",
    "Artifacts": [
      {
        "Role": "Install",
        "Payload": true,
        "EntryFile": "macos/Install.zsh",
        "IncludeSteps": true,
        "Wrapper": "bash-to-zsh",
        "CoreFiles": [
          "macos/core/Load.zsh",
          "macos/core/Ui.zsh",
          "macos/core/Ccq.zsh",
          "macos/core/Process.zsh",
          "macos/core/Profile.zsh",
          "macos/core/Platform.zsh",
          "macos/core/PackageManager.zsh",
          "macos/core/Json.zsh",
          "macos/core/Registry.zsh",
          "macos/core/Bootstrap.zsh",
          "macos/core/Update.zsh"
        ]
      },
      {
        "Role": "CcqDownload",
        "Payload": true,
        "OutputFile": "download-tui.zsh",
        "EntryFile": "macos/Download-Tui.zsh",
        "IncludeSteps": false,
        "Wrapper": "bash-to-zsh",
        "ReuseCoreFilesFromRole": "Install"
      }
    ]
  },
  "Linux": {
    "StepContract": "installer/contracts/steps.json",
    "Artifacts": [
      {
        "Role": "Install",
        "Payload": true,
        "EntryFile": "linux/Install.sh",
        "IncludeSteps": true,
        "CoreFiles": [
          "linux/core/Load.sh",
          "linux/core/Ui.sh",
          "linux/core/Ccq.sh",
          "linux/core/Process.sh",
          "linux/core/Profile.sh",
          "linux/core/Platform.sh",
          "linux/core/PackageManager.sh",
          "linux/core/Registry.sh",
          "linux/core/Bootstrap.sh"
        ]
      },
      {
        "Role": "CcqDownload",
        "Payload": true,
        "EntryFile": "linux/Download-Tui.sh",
        "IncludeSteps": false,
        "ReuseCoreFilesFromRole": "Install"
      }
    ]
  },
  "Unix": {
    "Artifacts": [
      {
        "Role": "Install",
        "OutputFile": "install.sh"
      },
      {
        "Role": "CcqDownload",
        "OutputFile": "download-tui.sh"
      }
    ]
  }
}
