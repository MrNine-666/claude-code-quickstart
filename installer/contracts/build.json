{
  "SchemaVersion": 1,
  "Source": "contracts/build.json",
  "DefaultOutputDirectory": "dist",
  "BuildEntrypoints": {
    "Windows": {
      "Script": "installer/build.ps1",
      "AllowedPlatforms": [
        "Windows"
      ],
      "Artifacts": [
        "install.ps1",
        "ccq-windows-x64.exe",
        "ccq-windows-x64.exe.gz",
        "ccq-windows-arm64.exe",
        "ccq-windows-arm64.exe.gz"
      ]
    },
    "MacOS": {
      "Script": "installer/build.sh",
      "AllowedPlatforms": [
        "macos"
      ],
      "Artifacts": [
        "install.sh",
        "ccq-macos-x64",
        "ccq-macos-x64.gz",
        "ccq-macos-arm64",
        "ccq-macos-arm64.gz"
      ]
    },
    "ReleaseArtifacts": [
      "install.ps1",
      "install.sh",
      "ccq-windows-x64.exe",
      "ccq-windows-x64.exe.gz",
      "ccq-windows-arm64.exe",
      "ccq-windows-arm64.exe.gz",
      "ccq-macos-x64",
      "ccq-macos-x64.gz",
      "ccq-macos-arm64",
      "ccq-macos-arm64.gz"
    ]
  },
  "UpdateTransports": {
    "GzipAssets": [
      {
        "Raw": "ccq-windows-x64.exe",
        "Gzip": "ccq-windows-x64.exe.gz"
      },
      {
        "Raw": "ccq-windows-arm64.exe",
        "Gzip": "ccq-windows-arm64.exe.gz"
      },
      {
        "Raw": "ccq-macos-x64",
        "Gzip": "ccq-macos-x64.gz"
      },
      {
        "Raw": "ccq-macos-arm64",
        "Gzip": "ccq-macos-arm64.gz"
      }
    ]
  },
  "Windows": {
    "StepContract": "installer/contracts/steps.json",
    "CanonicalStepPrefix": "windows/",
    "Artifacts": [
      {
        "Role": "Install",
        "OutputFile": "install.ps1",
        "RequiresHeader": "#Requires -Version 5.1",
        "EntryFile": "windows/Install.ps1",
        "HoistParamFrom": "windows/Install.ps1",
        "OutputEncoding": "asciiTrampoline",
        "CoreFiles": [
          "windows/core/Json.ps1",
          "windows/core/Ui.ps1",
          "windows/core/Process.ps1",
          "windows/core/Profile.ps1",
          "windows/core/Update.ps1",
          "windows/core/Admin.ps1",
          "windows/core/Net.ps1",
          "windows/core/Registry.ps1",
          "windows/core/Bootstrap.ps1"
        ],
        "IncludeSteps": true
      }
    ]
  },
  "MacOS": {
    "StepContract": "installer/contracts/steps.json",
    "Artifacts": [
      {
        "Role": "Install",
        "OutputFile": "install.sh",
        "EntryFile": "macos/Install.zsh",
        "IncludeSteps": true,
        "Wrapper": "bash-to-zsh",
        "CoreFiles": [
          "macos/core/Ui.zsh",
          "macos/core/Process.zsh",
          "macos/core/Profile.zsh",
          "macos/core/Platform.zsh",
          "macos/core/PackageManager.zsh",
          "macos/core/Json.zsh",
          "macos/core/Registry.zsh",
          "macos/core/Bootstrap.zsh",
          "macos/core/Update.zsh"
        ]
      }
    ]
  }
}
