{
  "name": "tui",
  "version": "0.0.0-dev",
  "module": "src/index.tsx",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development bun run --watch src/index.tsx",
    "build": "bun run scripts/build.ts",
    "build:windows-x64": "bun build --compile --no-compile-autoload-dotenv --target=bun-windows-x64 --outfile=../dist/ccq-windows-x64.exe src/index.tsx",
    "build:windows-arm64": "bun build --compile --no-compile-autoload-dotenv --target=bun-windows-arm64 --outfile=../dist/ccq-windows-arm64.exe src/index.tsx",
    "build:macos-x64": "bun build --compile --no-compile-autoload-dotenv --target=bun-darwin-x64 --outfile=../dist/ccq-macos-x64 src/index.tsx",
    "build:macos-arm64": "bun build --compile --no-compile-autoload-dotenv --target=bun-darwin-arm64 --outfile=../dist/ccq-macos-arm64 src/index.tsx",
    "generate-icon": "bun run scripts/generate-icon.ts",
    "format": "bun scripts/biome-format.mjs --write",
    "format:check": "bun scripts/biome-format.mjs",
    "lint": "biome lint --diagnostic-level=error src scripts tests",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "test": "bun test tests/core/gzip-assets.test.ts",
    "verify": "bun scripts/verify-build-runtime.mjs && bun scripts/verify-compiled-contracts.mjs && bun scripts/verify-gzip-assets.mjs && bun scripts/verify-self-update.mjs",
    "check": "bun run typecheck && bun run test && bun run verify"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "sharp": "^0.35.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/react": "0.4.5",
    "opentui-spinner": "^0.0.7",
    "react": "19.2.6",
    "smol-toml": "^1.7.0"
  }
}
