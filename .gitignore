# ─── 本地 AI 工具数据（不纳入版本控制）───
.claude/
.agents/
.codex/
.trellis/

# ─── 构建产物（由本地构建或 GitHub Actions 自动生成）───
dist/
installer/build/*.zip
installer/build/*.exe

# ─── Windows 系统垃圾文件 ───
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# ─── 编辑器临时文件 ───
*.tmp
*.bak
*.swp
*~

# ─── PowerShell 产物 ───
*.psc1

# ─── Node.js 依赖（由 package.json / package-lock.json 还原，不纳入版本控制）───
node_modules/
npm-debug.log*
.npm/
tui/.*.bun-build
