# ─── 本地 AI 工具数据（不纳入版本控制）───
.claude/
.agents/
.codex/
.pi/
.trellis/

# ─── main/dist 人工脚本；二进制、gzip 和临时产物继续忽略 ───
/dist/*
!/dist/install.ps1
!/dist/install.sh
!/dist/download-tui.ps1
!/dist/download-tui.zsh
installer/build/*.zip
installer/build/*.exe

# ─── Windows 系统垃圾文件 ───
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# ─── 编辑器临时文件 ───
*.tmp
*.bak
*.swp
*~

# ─── PowerShell 产物 ───
*.psc1

# ─── Node.js 依赖（由 package.json / package-lock.json 还原，不纳入版本控制）───
node_modules/
npm-debug.log*
.npm/
tui/.*.bun-build
